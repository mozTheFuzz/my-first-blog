# Copy to .env and fill in real values. Never commit .env (.gitignore already excludes it).

# Secret used to sign the login session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# LINE Login channel (LINE Developers Console → your provider → LINE Login channel → Basic settings)
LINE_CHANNEL_ID=0000000000
LINE_CHANNEL_SECRET=change-me
